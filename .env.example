# ==============================================
# POS Lite — Environment Variables
# ==============================================

# ---- Database (required) ----
DATABASE_URL=postgresql://neondb_owner:password@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require
PG_APP_USER=app_user
PG_APP_PASSWORD=your_app_user_password

# ---- Auth (required) ----
JWT_SECRET=change-me-to-a-random-64-char-string
ADMIN_SECRET=change-me-admin-secret

# ---- Multi-Tenancy ----
DEFAULT_TENANT_ID=your-default-tenant-id

# ---- Payments — Stripe (required for card payments) ----
STRIPE_SECRET_KEY=sk_test_...
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ---- Stripe Billing (for $20/mo subscription) ----
STRIPE_PRICE_STARTER=price_...
STRIPE_PRICE_PRO=price_...
APP_URL=https://pos.yourdomain.com

# ---- Payments — Conekta (Mexico, optional) ----
CONEKTA_PRIVATE_KEY=key_...
CONEKTA_PUBLIC_KEY=key_...
# RSA public key (PEM) used to verify inbound webhook signatures. Generate via
# Conekta's /webhook_keys endpoint and paste the full PEM block including the
# BEGIN/END lines. When unset, signature verification is skipped (insecure).
CONEKTA_WEBHOOK_PUBLIC_KEY=

# ---- Payments — Mercado Pago (LATAM, optional) ----
MP_ACCESS_TOKEN=APP_USR-...
MP_CLIENT_ID=...
MP_CLIENT_SECRET=...
MP_REDIRECT_URI=https://pos.yourdomain.com/api/payments/mp/callback

# ---- Payments — Getnet (optional) ----
GETNET_CLIENT_ID=...
GETNET_CLIENT_SECRET=...
GETNET_MERCHANT_ID=...

# ---- CFDI Invoicing — FacturAPI (Mexico, optional) ----
FACTURAPI_API_KEY=...
# Optional: default expiry (hours) for public "solicita factura" QR links.
CFDI_INVOICE_LINK_EXPIRY_HOURS=72

# ---- Email — Resend (optional) ----
RESEND_API_KEY=re_...

# ---- SMS — Twilio (optional, for loyalty) ----
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=...
TWILIO_PHONE_NUMBER=+1...

# ---- AI Agent (Co-Pilot, optional) ----
ANTHROPIC_API_KEY=sk-ant-...

# ---- Menu photos — object storage (Cloudflare R2, optional) ----
# When ALL five R2_* vars are set, uploaded menu photos are stored in R2 and
# served from R2_PUBLIC_HOST. If any are missing, the app falls back to local
# disk under data/uploads/ (works for dev, but Railway's filesystem is
# ephemeral — provision R2 before relying on photos surviving a redeploy).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Public read host for the bucket (no scheme), e.g. img.desktop.kitchen
R2_PUBLIC_HOST=

# Menu photo upload pipeline. Default ON. Set to false to hide the in-app
# upload UI and disable the upload endpoint (menu browsing is unaffected).
FEATURE_MENU_PHOTOS=true
# Client-side twin of the flag (must be VITE_-prefixed to reach the browser).
VITE_FEATURE_MENU_PHOTOS=true

# ---- Server ----
PORT=3001
NODE_ENV=development
