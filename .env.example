# ==============================================
# POS Lite — Environment Variables
# ==============================================

# ---- Database (required) ----
DATABASE_URL=postgresql://neondb_owner:password@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require
PG_APP_USER=app_user
PG_APP_PASSWORD=your_app_user_password

# ---- Auth (required) ----
JWT_SECRET=change-me-to-a-random-64-char-string
ADMIN_SECRET=change-me-admin-secret

# ---- Multi-Tenancy ----
DEFAULT_TENANT_ID=your-default-tenant-id

# ---- Payments — Stripe (required for card payments) ----
STRIPE_SECRET_KEY=sk_test_...
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ---- Stripe Billing (for $20/mo subscription) ----
STRIPE_PRICE_STARTER=price_...
STRIPE_PRICE_PRO=price_...
# Founders offer ($799 MXN/mes de por vida) — used by the public pay-first checkout
STRIPE_PRICE_FOUNDERS=price_...
APP_URL=https://pos.yourdomain.com

# ---- Payments — Mercado Pago (LATAM, optional) ----
MP_ACCESS_TOKEN=APP_USR-...
MP_CLIENT_ID=...
MP_CLIENT_SECRET=...
MP_REDIRECT_URI=https://pos.yourdomain.com/api/payments/mp/callback
# Webhook signing secret from the MP dashboard. When set, /payments/mp/webhook
# verifies the x-signature HMAC and rejects forgeries; when UNSET it falls back
# to fail-open (mitigated by a live re-pull of the order from MP before trusting
# it). Set this before onboarding any tenant that takes Mercado Pago payments.
MP_WEBHOOK_SECRET=...

# ---- Payments — Getnet (optional) ----
GETNET_CLIENT_ID=...
GETNET_CLIENT_SECRET=...
GETNET_MERCHANT_ID=...

# ---- CFDI Invoicing — FacturAPI (Mexico, optional) ----
FACTURAPI_API_KEY=...
# Optional: default expiry (hours) for public "solicita factura" QR links.
CFDI_INVOICE_LINK_EXPIRY_HOURS=72

# ---- Email — Resend (optional) ----
RESEND_API_KEY=re_...

# ---- SMS — Twilio (optional, for loyalty) ----
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=...
TWILIO_PHONE_NUMBER=+1...

# ---- WhatsApp — Meta Cloud API (coexistence numbers, optional) ----
# Numbers stay on the WhatsApp Business app on the restaurant phone AND connect
# here via Meta "coexistence" for employee voice-ops (and later the order bot).
#
# PER-TENANT values (access_token, phone_number_id, waba_id) do NOT live here —
# they're stored in tenant_credentials (service='whatsapp') by the Embedded
# Signup flow at /admin/wa-onboarding, because every tenant restaurant connects
# their own number. Inbound messages route to a tenant by phone_number_id.
#
# The two below are only the PLATFORM fallback — DK's own number
# (+52 56 1309 6835). A tenant with stored credentials ignores them.
WA_CLOUD_ACCESS_TOKEN=
WA_CLOUD_PHONE_NUMBER_ID=
# Human-readable form of the number above, shown to owners on /admin/whatsapp
# when their tenant is on the platform fallback (tenants with their own number
# get it from tenant_credentials instead). Display only — never used to send.
# For DK that's the number in the comment above: 5613096835
WA_CLOUD_DISPLAY_PHONE_NUMBER=
# Platform-wide, NOT per-tenant: every tenant WABA delivers to one webhook and
# is signed with OUR Tech Provider app secret. Blanking WA_CLOUD_APP_SECRET is
# the kill switch for ALL numbers (the route then 503s); blanking
# WA_CLOUD_ACCESS_TOKEN only silences DK's own number.
WA_CLOUD_APP_SECRET=
WA_CLOUD_VERIFY_TOKEN=
# Graph API version for all Cloud API calls (default v23.0)
# WA_GRAPH_VERSION=v23.0
# 'on' accepts UNSIGNED webhooks — onboarding/testing only, never leave on.
# WA_CLOUD_ALLOW_UNSIGNED=on

# Embedded Signup onboarding (only needed to CONNECT a number; see
# /admin/wa-onboarding and docs/whatsapp-tech-provider-onboarding.md).
# We run this as our own Meta Tech Provider — the same flow onboards DK's
# number and each tenant restaurant's number, one per tenant.
WA_META_APP_ID=
WA_META_APP_SECRET=
WA_ES_CONFIG_ID=

# ---- Wallet Passes — Apple (optional, for loyalty) ----
# Platform-wide cert set (Desktop Kitchen's Pass Type ID serves all tenants).
# Extract PEMs from the Keychain-exported .p12:
#   openssl pkcs12 -in pass.p12 -clcerts -nokeys -legacy | openssl x509 > signerCert.pem
#   openssl pkcs12 -in pass.p12 -nocerts -legacy -passout pass:<phrase> > signerKey.pem
# WWDR G4 intermediate: https://www.apple.com/certificateauthority/ (convert .cer to PEM)
# Then base64-encode each PEM file for the env values below.
APPLE_TEAM_ID=XXXXXXXXXX
APPLE_PASS_TYPE_ID=pass.kitchen.desktop.loyalty
APPLE_PASS_CERT_BASE64=...
APPLE_PASS_KEY_BASE64=...
APPLE_PASS_KEY_PASSPHRASE=...
APPLE_WWDR_CERT_BASE64=...

# ---- Wallet Passes — Google (optional; both required to enable) ----
# 1) Sign up at Google Pay & Wallet Console (business account) -> issuer id
# 2) Create a GCP service account, grant it access in the Wallet Console,
#    download its JSON key, then: base64 -i key.json
GOOGLE_WALLET_ISSUER_ID=...
GOOGLE_WALLET_SA_KEY_BASE64=...

# ---- AI Agent (Co-Pilot, optional) ----
ANTHROPIC_API_KEY=sk-ant-...

# ---- Menu photos — object storage (Cloudflare R2, optional) ----
# When ALL five R2_* vars are set, uploaded menu photos are stored in R2 and
# served from R2_PUBLIC_HOST. If any are missing, the app falls back to local
# disk under data/uploads/ (works for dev, but Railway's filesystem is
# ephemeral — provision R2 before relying on photos surviving a redeploy).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Public read host for the bucket (no scheme), e.g. img.desktop.kitchen
R2_PUBLIC_HOST=

# Menu photo upload pipeline. Default ON. Set to false to hide the in-app
# upload UI and disable the upload endpoint (menu browsing is unaffected).
FEATURE_MENU_PHOTOS=true
# Client-side twin of the flag (must be VITE_-prefixed to reach the browser).
VITE_FEATURE_MENU_PHOTOS=true

# ---- Server ----
PORT=3001
NODE_ENV=development

# ---- Background sweeps (prod-gated by default) ----
# All background sweeps refuse to boot when NODE_ENV != production, because
# local `npm run dev` connects to the same prod Neon DATABASE_URL and a
# laptop-side sweep would fire real outbound side effects (SMS / notifications
# / autofix mutations) against real prod data.
#
# Each sweep has ITS OWN override so debugging one doesn't silently start the
# others. Symmetric tri-state where applicable: off = kill switch anywhere,
# on = force anywhere, unset = prod-only default.
#
# ENABLE_BACKGROUND_SMS=true  → winback + reward-reminder + post-order-review SMS
# AUTO_COMPLETE_ENABLED=on    → ready→completed order sweep
# SENTINEL_ENABLED=on         → sentinel incident sweep (off = kill switch)
# SENTINEL_AUTOFIX=on         → sentinel playbooks mutate (default: shadow-only)
# SENTINEL_TRIAGE=off         → skip LLM triage; sensors still detect + record
# SENTINEL_ALERT_WEBHOOK=...  → Slack/Discord/etc. incoming webhook URL for new
#                               and self-healed incidents (set before pilot #1)
# See server/sentinel/sensors.js for per-sensor threshold overrides
# (SENTINEL_STUCK_TERMINAL_MINUTES, SENTINEL_STALE_DRAFT_MINUTES, etc.)
