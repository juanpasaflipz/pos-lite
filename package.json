{
  "name": "pos-lite",
  "version": "1.0.0",
  "description": "Lean, multi-tenant POS system — $20/mo SaaS",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:client": "vite",
    "dev:server": "node server/index.js",
    "dev:kiosk": "vite --config vite.kiosk.config.ts",
    "build": "vite build && vite build --config vite.kiosk.config.ts",
    "build:client": "vite build",
    "build:kiosk": "vite build --config vite.kiosk.config.ts",
    "start": "NODE_ENV=production node server/index.js",
    "smoketest:orders": "node scripts/load-test-orders.mjs"
  },
  "dependencies": {
    "@stripe/react-stripe-js": "^5.6.1",
    "@stripe/stripe-js": "^8.10.0",
    "bcrypt": "^6.0.0",
    "conekta": "^8.0.0",
    "cors": "^2.8.5",
    "dexie": "^4.3.0",
    "dotenv": "^17.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^8.2.1",
    "facturapi": "^4.13.1",
    "helmet": "^8.1.0",
    "i18next": "^25.8.11",
    "i18next-browser-languagedetector": "^8.2.1",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^0.564.0",
    "multer": "^2.0.2",
    "papaparse": "^5.5.3",
    "postgres": "^3.4.8",
    "qrcode.react": "^4.2.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-i18next": "^16.5.4",
    "react-router-dom": "^6.21.0",
    "recharts": "^2.10.3",
    "stripe": "^14.0.0",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.16",
    "concurrently": "^8.2.2",
    "postcss": "^8.4.32",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.3.3",
    "vite": "^5.0.8"
  }
}
