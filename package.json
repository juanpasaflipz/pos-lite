{
  "name": "pos-lite",
  "version": "1.8.2",
  "description": "Lean, multi-tenant POS system — $20/mo SaaS",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:client": "vite",
    "dev:server": "node server/index.js",
    "dev:kiosk": "vite --config vite.kiosk.config.ts",
    "build": "node scripts/gen-version.mjs && vite build && vite build --config vite.kiosk.config.ts",
    "version:stamp": "node scripts/gen-version.mjs",
    "build:client": "vite build",
    "build:kiosk": "vite build --config vite.kiosk.config.ts",
    "android:sync": "node scripts/gen-version.mjs && npm run build:kiosk && cap sync android",
    "android:apk": "npm run android:sync && JAVA_HOME=\"/Applications/Android Studio.app/Contents/jbr/Contents/Home\" ./android/gradlew -p ./android assembleDebug && echo \"\\nAPK: $(pwd)/android/app/build/outputs/apk/debug/app-debug.apk\"",
    "android:install": "npm run android:apk && adb install -r ./android/app/build/outputs/apk/debug/app-debug.apk",
    "start": "NODE_ENV=production node server/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ci": "vitest run --reporter=verbose",
    "typecheck": "tsc --noEmit -p . && tsc --noEmit -p kiosk",
    "smoketest:orders": "node scripts/load-test-orders.mjs",
    "smoketest:kds": "node scripts/verify-kds-seen.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.679.0",
    "@capacitor/android": "^7.6.5",
    "@capacitor/app": "^7.1.2",
    "@capacitor/core": "^7.6.5",
    "@capacitor/haptics": "^7.0.5",
    "@capacitor/keyboard": "^7.0.6",
    "@capacitor/splash-screen": "^7.0.5",
    "@capacitor/status-bar": "^7.0.6",
    "@stripe/react-stripe-js": "^5.6.1",
    "@stripe/stripe-js": "^8.10.0",
    "@types/sharp": "^0.31.1",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.5",
    "dexie": "^4.3.0",
    "dotenv": "^17.3.1",
    "exceljs": "^4.4.0",
    "express": "^4.18.2",
    "express-rate-limit": "^8.2.1",
    "facturapi": "^4.13.1",
    "helmet": "^8.1.0",
    "i18next": "^25.8.11",
    "i18next-browser-languagedetector": "^8.2.1",
    "jsonwebtoken": "^9.0.3",
    "jsqr": "^1.4.0",
    "lucide-react": "^0.564.0",
    "multer": "^2.0.2",
    "papaparse": "^5.5.3",
    "passkit-generator": "^3.5.7",
    "postgres": "^3.4.8",
    "qrcode.react": "^4.2.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-i18next": "^16.5.4",
    "react-router-dom": "^6.21.0",
    "recharts": "^2.10.3",
    "sharp": "^0.33.5",
    "stripe": "^14.0.0",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.6.5",
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@types/supertest": "^6.0.3",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.16",
    "concurrently": "^8.2.2",
    "dotenv-cli": "^7.4.4",
    "postcss": "^8.4.32",
    "supertest": "^7.2.2",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.3.3",
    "vite": "^5.0.8",
    "vitest": "^2.1.9"
  }
}
